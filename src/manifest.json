{
  "manifest_version": 3,
  "name": "Gnosis Pay Transaction Page",
  "version": "1.3",
  "description": "Opens a new tab displaying transaction data from app.gnosispay.com API with filtering, column config, and export.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://app.gnosispay.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Show Gnosis Transactions",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [ "ineligible_mccs.json" ],
      "matches": [ "<all_urls>" ]
    }
  ]
}